# Copy this file to .env and fill it in. See SETUP.md for details.

# "production" for the office server; leave unset for development
NODE_ENV=production

# Port the server listens on
PORT=3001

# Secret used to sign sign-in tokens. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=

# First administrator, created only when the database is empty (a brand-new install).
# They must choose a new password at first sign-in, so this one can be temporary.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Where data, uploads and backups live (defaults to ./data and ./data/backups)
# DATA_DIR=
# BACKUP_DIR=
# How many daily backups to keep
# BACKUP_KEEP=30

# Set both to true once the app is served over HTTPS through a reverse proxy (e.g. Caddy)
# HTTPS=true
# TRUST_PROXY=true

# Load the demo company and projects (password novadesk123). Never on a real server.
# SEED_DEMO=false
