# Copy this file to .env and fill it in. See SETUP.md for details.

# "production" for the office server; leave unset for development
NODE_ENV=production

# Port the server listens on
PORT=3001

# Secret used to sign sign-in tokens. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=

# First administrator, created only when the database is empty (a brand-new install).
# They must choose a new password at first sign-in, so this one can be temporary.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# HandleMyDesk owner (you): signs in on the normal sign-in screen and gets the owner console,
# where you see every office (customer company), add or pause offices, go inside one to fix
# things, and answer "Report a problem". Created on first start if no owner exists yet.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
# Name of the first office (the original installation)
# MAIN_OFFICE_NAME=Main office

# Keep a copy of all data in Postgres (e.g. Neon, free) so it survives restarts on hosts without a
# disk (Render free plan). An empty data folder is filled from it at start-up. See DEPLOY.md.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# On Render's free plan the server visits its own address every 10 minutes so it never sleeps
# (uses RENDER_EXTERNAL_URL, which Render sets). Set to false on a paid plan.
# KEEP_AWAKE=true

# "Forgot password?" by email. Set ONE key: Brevo (300/day free) or Resend (3,000/month free).
# Without one, an administrator resets the password instead.
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
# MAIL_FROM=HandleMyDesk <noreply@yourdomain.com>
# The website people use; links in emails point here (required for email in production)
# APP_URL=https://handlemydesk.vercel.app

# Phone notifications: generate with  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Where data, uploads and backups live (defaults to ./data and ./data/backups)
# DATA_DIR=
# BACKUP_DIR=
# How many daily backups to keep
# BACKUP_KEEP=30

# Set both to true once the app is served over HTTPS through a reverse proxy (e.g. Caddy)
# HTTPS=true
# TRUST_PROXY=true

# Load the demo company and projects (password handlemydesk123). Never on a real server.
# SEED_DEMO=false

# Log format: one readable line per request by default; "json" for log tools
# LOG_FORMAT=json

# Company single sign-on (OpenID Connect: Microsoft Entra ID, Google Workspace, …). See SETUP.md.
# SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URL=https://handlemydesk.office.example/api/auth/sso/callback
# SSO_LABEL=Microsoft
# SSO_AUTO_CREATE=false
